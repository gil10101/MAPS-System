# Copy this file to ".env" and fill in the values.

# --- Database (PostgreSQL) ---------------------------------------------------
# Create a free Postgres database at https://neon.tech (no credit card):
#   1. Sign up, create a project (e.g. "medisync").
#   2. Copy the connection string from the dashboard.
# It looks like:
#   postgres://USER:PASSWORD@ep-xxx-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# Teammates can share the same connection string.
# (A local Postgres also works: postgres://postgres:postgres@localhost:5432/medisync)
DATABASE_URL=

# --- Auth --------------------------------------------------------------------
# Secret used to sign JWT auth tokens. CHANGE THIS in production.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# How long an auth token stays valid
JWT_EXPIRES_IN=7d

# --- Server ------------------------------------------------------------------
# Port the server listens on
PORT=3000

# Node environment: development | production
NODE_ENV=development
